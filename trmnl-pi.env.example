TRMNL_BASE_URL=https://usetrmnl.com
TRMNL_API_KEY=replace-me
TRMNL_MAC=replace-me
# Waveshare driver for the attached panel: epd7in5_V2 or epd7in3e
TRMNL_PANEL=epd7in5_V2

# Optional tuning
# TRMNL_MODEL and TRMNL_MIN_REFRESH_SECONDS default to the panel's values
#TRMNL_MODEL="Waveshare 7.5 V2"
#TRMNL_MIN_REFRESH_SECONDS=1
# auto: draw images with grays in the panel's 4-gray mode; off: always 1-bit
#TRMNL_GRAYSCALE=auto
# 4-gray waveform: trmnl (default), trmnl-dark or waveshare; trmnl* read bb_epaper
#TRMNL_GRAY_MODE=trmnl
#BB_EPAPER_SRC=$HOME/bb_epaper/src
# FW-Version sent to TRMNL; palettes such as 4 grays need 1.6 or later
#TRMNL_FW_VERSION=1.8.17
TRMNL_WIDTH=800
TRMNL_HEIGHT=480
TRMNL_RUN_TIMEOUT=780s
TRMNL_DISPLAY_TIMEOUT=600
TRMNL_DISPLAY_CLEANUP_TIMEOUT=30
TRMNL_HTTP_TOTAL_TIMEOUT=120
TRMNL_HTTP_ATTEMPTS=3
TRMNL_HTTP_RETRY_DELAY=5
TRMNL_FORCE_REDRAW_HOURS=12
# Optional Uptime Kuma push monitor, pinged after each successful run
TRMNL_HEARTBEAT_URL=
# Optional curl --resolve override (host:port:address) for the heartbeat
TRMNL_HEARTBEAT_RESOLVE=
# Optional: save each drawn image as <dir>/current.png for a mirroring display
TRMNL_PUBLISH_DIR=
WAVESHARE_LIB=$HOME/e-Paper/RaspberryPi_JetsonNano/python/lib
